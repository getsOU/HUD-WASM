<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup><OutputType>Exe</OutputType><RootNamespace>BasicHud</RootNamespace></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/BasicHud.Core/BasicHud.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <RazorComponent Include="../../src/BasicHud/_Imports.razor" Link="_Imports.razor" />
    <RazorComponent Include="../../src/BasicHud/Components/*.razor" Link="Components/%(Filename)%(Extension)" />
    <RazorComponent Include="../../src/BasicHud/Views/*.razor" Link="Views/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><None Include="../../src/BasicHud/wwwroot/panel.json" Link="panel.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <None Include="../../src/BasicHud/hud.json" Link="hud.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/BasicHud/MetadataPoller.cs" Link="MetadataPoller.cs" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
  </ItemGroup>
</Project>
