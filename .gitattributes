* text=auto eol=lf
*.png binary
*.souhud binary
# Preserve original game assets byte for byte against the provenance inventory.
src/BasicHud/wwwroot/assets/** -text
# Imported SVG source whitespace is part of its recorded upstream hash.
src/BasicHud/wwwroot/assets/**/*.svg -whitespace
src/BasicHud/wwwroot/assets/boltobserv/** -whitespace
# Upstream license notices retain their original whitespace.
LICENSES/** -whitespace
LICENSES/BOLTOBSERV* -text -whitespace
LICENSES/SOU-SDK-MIT.txt -text -whitespace
LICENSES/OPENHUD-MIT.txt -text -whitespace
