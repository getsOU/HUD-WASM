<HudRenderBoundary RenderKey="Context" Now="Context.Now" ClockMilliseconds="Milliseconds" Context="now">
    @ChildContent(Context with { Now = now })
</HudRenderBoundary>
@code {
    [Parameter, EditorRequired] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    [Parameter] public int Milliseconds { get; set; } = 100;
    [Parameter, EditorRequired] public RenderFragment<BroadcastContext> ChildContent { get; set; } = default!;
}
