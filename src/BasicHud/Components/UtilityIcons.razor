@if (Player.Health is not <= 0)
{
    <span class="utility-icons" aria-label="Utility">
        @foreach (var utility in EquipmentPresentation.Utility(Player))
        {
            @for (var copy = 0; copy < EquipmentPresentation.UtilityCopies(utility.Count); copy++)
            {
                <span class="utility-item" data-utility="@utility.Name" @key="(utility.Name, copy)" title="@utility.Label"><EquipmentIcon Name="@utility.Name" /></span>
            }
        }
        @if (Player.Weapons is null || Player.Weapons.Value.IsDefault) { <span title="Utility not supplied">—</span> }
    </span>
}
else { <span class="utility-icons" aria-label="Utility"></span> }
@code { [Parameter] public PlayerState Player { get; set; } = null!; }
