<ImageTile Source="@Context.ProfileImage(Player.SteamId, ReferenceImage)" FallbackSource="@AgentPortraits.For(Player)" Label="@(DisplayName ?? Context.Name(Player))" Class="@Class" OmitFallback="OmitFallback" Effects="@PortraitEffects.From(Player, Context.Snapshot?.Freshness)" EffectsBinding="@Binding" EffectsAllowed="@(Context.Snapshot?.Freshness == DataFreshness.Live && Player.Health is not <= 0)" />
@code {
    [Parameter, EditorRequired] public PlayerState Player { get; set; } = null!;
    [Parameter, EditorRequired] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    [Parameter] public string? ReferenceImage { get; set; }
    [Parameter] public string? DisplayName { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool OmitFallback { get; set; }
    private string Binding => $"{Context.Snapshot?.SessionId}:{Context.Game?.Map}:{Context.Game?.RoundNumber}:{Player.SteamId ?? $"{Player.Side}:{Player.ObserverSlot}"}";
}
