@if (Cs2Icons.Status(Name) is { } source && failed != source)
{
    <span class="cs2-icon status-icon @Class" data-icon="@source" title="@Label"><img class="icon-source" src="@($"assets/{source}.svg")" alt="@Label" aria-label="@Label" data-cs2-icon="@source" @onerror="() => failed = source" /></span>
}
else
{
    <span class="icon-label @Class" aria-label="@Label" title="@Label">@Label</span>
}
@code {
    [Parameter] public string Name { get; set; } = "unknown";
    [Parameter] public string Label { get; set; } = "Unknown";
    [Parameter] public string Class { get; set; } = "";
    private string? failed;
}
