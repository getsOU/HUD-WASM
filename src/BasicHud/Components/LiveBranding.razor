@{
    var competition = Context.Match?.Competition;
    var logo = Context.ResolveMedia(competition?.Logo);
}
@if (logo is not null || ShowSponsors && Context.SponsorImages().Count > 0)
{
    <aside class="live-branding" style="@FormattableString.Invariant($"--competition-logo-scale:{Context.CompetitionLogoHeightPercent / 100};--sponsor-logo-scale:{Context.SponsorHeightPercent / 100}")" aria-label="Competition and sponsors">
        @if (logo is not null) { <ImageTile Source="@logo" Label="@(competition?.Name ?? "Competition")" Class="live-competition-logo" OmitFallback="true" /> }
        @if (ShowSponsors) { <Sponsors Context="Context" Rotate="true" /> }
    </aside>
}
@code {
    [Parameter] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    [Parameter] public bool ShowSponsors { get; set; } = true;
}
