@if (!failed && EquipmentPresentation.Key(Name) is { } key && key is not ("world" or "worldent" or "trigger_hurt"))
{
    <span class="cs2-icon equipment-icon @Class" data-icon="@($"weapons/{key}")" title="@EquipmentPresentation.Label(Name)"><img class="icon-source" src="@($"assets/weapons/{key}.svg")" alt="@EquipmentPresentation.Label(Name)" @onerror="() => failed = true" /></span>
}
else
{
    <span class="icon-label @Class" title="@EquipmentPresentation.Label(Name)">@EquipmentPresentation.Label(Name)</span>
}
@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string Class { get; set; } = "";
    private string? previous;
    private bool failed;
    protected override void OnParametersSet() { if (previous != Name) { failed = false; previous = Name; } }
}
