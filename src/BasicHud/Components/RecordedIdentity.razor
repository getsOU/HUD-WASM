<div class="recorded-identity">
    <ImageTile Source="@Context.ProfileImage(SteamId)" FallbackSource="@AgentPortraits.ForRecorded(Context, SteamId, Side)" Label="@DisplayName" Class="recorded-avatar" Position="@DisplayOptions.PortraitPosition(Context.Panel)" />
    <span class="recorded-name">@DisplayName</span>
</div>
@code {
    private static readonly RecordingCopy Locale = RecordingCopy.Instance;
    private string DisplayName => SourceText.Name(Name);
    [Parameter] public string? SteamId { get; set; }
    [Parameter] public TeamSide? Side { get; set; }
    [Parameter] public string Name { get; set; } = "—";
    [Parameter] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
}
