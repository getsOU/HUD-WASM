@if ((Always || MatchPresentation.ShowHistory(Context.Game)) && MatchPresentation.History(Context.Game, Always) is { Count: > 0 } results)
{
    <section class="round-history" aria-label="Recent round results">
        @foreach (var round in results)
        {
            <span class="history-round @PlayerPresentation.SideClass(round.Winner)" title="@($"Round {round.RoundNumber}: {round.Winner}, {MatchPresentation.Reason(round.Reason)}")"><small>@round.RoundNumber</small><StatusIcon Name="@MatchPresentation.ReasonIcon(round.Reason)" Label="@MatchPresentation.Reason(round.Reason)" /></span>
        }
    </section>
}
@code {
    [Parameter] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    [Parameter] public bool Always { get; set; }
}
