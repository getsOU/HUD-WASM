<header class="scene-header recording-heading broadcast-heading">
    <div class="recording-mark"><Branding Context="Context" ShowCompetition="false" /><span class="recording-wordmark">sOU</span></div>
    <div class="recording-title"><span class="recording-kicker">@Context.Match?.Name</span>
        <h1 title="@Context.TextOr(PanelSection, "title", Title)">@Context.TextOr(PanelSection, "title", Title)</h1>
        @if (PanelSection == "production" && Context.Text("production", "subtitle") is { Length: > 0 } subtitle) { <p class="scene-subtitle">@subtitle</p> }
    </div>
    <div class="recording-map"><strong>@MapName</strong></div>
</header>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string PanelSection { get; set; } = "production";
    [Parameter] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    private string MapName => (Context.Game?.Map ?? "MAP UNKNOWN").Replace("de_", "", StringComparison.Ordinal).ToUpperInvariant();
}
