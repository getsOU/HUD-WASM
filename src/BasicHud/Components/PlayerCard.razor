<article class="player-card @PlayerPresentation.SideClass(Player.Side) @(Player.Health is <= 0 ? "is-dead" : "") @(Expanded ? "expanded" : "")">
    <div class="player-identity"><span class="observer-slot">@(Player.ObserverSlot is >= 0 and <= 9 ? Player.ObserverSlot.ToString() : "—")</span>
        <PlayerPortrait Player="Player" Context="Context" DisplayName="@Name" Class="portrait" />
        <strong class="player-name" title="@Name">@Name</strong><span class="money">@if (Player.Money is { } money) { <span class="card-currency">$</span>@(" ")<span class="card-money-value">@money.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span> } else { <text>—</text> }</span></div>
    <div class="player-vitals"><PlayerEquipment Player="Player" Context="Context" /><b aria-label="Health">@BroadcastContext.Number(Player.Health)</b>
        <span class="kda" aria-label="@($"Kills / deaths / assists: {PlayerPresentation.Kda(Player)}")"><span><StatusIcon Name="kills" Label="Kills" /> @BroadcastContext.Number(Player.Stats?.Kills)</span><span><StatusIcon Name="dead" Label="Deaths" /> @BroadcastContext.Number(Player.Stats?.Deaths)</span><span title="Assists">A @BroadcastContext.Number(Player.Stats?.Assists)</span></span></div>
    <Inventory Player="Player" />
    <div class="player-round"><span>EQ @Equipment</span><span>RK @BroadcastContext.Number(Player.RoundKills)</span><span>DMG @BroadcastContext.Number(Player.RoundDamage)</span></div>
    @if (PlayerPresentation.Conditions(Player) is { Length: > 0 } conditions) { <div class="player-conditions">@conditions</div> }
    @if (Expanded)
    {
        <div class="advanced-stats"><span>ADR <b>@BroadcastContext.Decimal(Player.RecordedStats?.AverageDamagePerRound)</b></span><span>HS <b>@BroadcastContext.Decimal(Player.RecordedStats?.HeadshotPercentage)%</b></span><span>MVP @BroadcastContext.Number(Player.Stats?.Mvps)</span></div>
        <p class="coverage">@BroadcastContext.Coverage(Player.RecordedStats)</p>
    }
    <div class="health-track" aria-hidden="true"><span style="@HealthWidth"></span></div>
</article>
@code {
    [Parameter, EditorRequired] public PlayerState Player { get; set; } = null!;
    [Parameter, EditorRequired] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public string? DisplayName { get; set; }
    private string Name => DisplayName ?? Context.Name(Player);
    private string Equipment => Player.EquipmentValue is { } value ? "$" + value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) : "—";
    private string HealthWidth => "width:" + (Player.Health is { } value ? Math.Clamp(value, 0, 100) : 0).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";
}
