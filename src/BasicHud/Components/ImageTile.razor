@if (CurrentSource is { } source)
{
    @if (Effects is not null)
    {
        <span class="local-image avatar-frame @Class">
            <img class="avatar-image" src="@source" alt="@ImageLabel(source)" data-image-fallback="@(source == FallbackSource ? "true" : null)" @onerror="() => ImageFailed(source)" />
            @if (Effects.Any)
            {
                <span class="avatar-effects" style="@MaskStyle(source)" aria-hidden="true">
                    @if (Effects.Smoke) { <span class="avatar-effect avatar-smoke"></span> }
                    @if (Effects.Fire) { <span class="avatar-effect avatar-fire"></span> }
                    @if (Effects.Flash) { <span class="avatar-effect avatar-flash"></span> }
                </span>
            }
        </span>
    }
    else
    {
        <img class="local-image @Class" src="@source" alt="@ImageLabel(source)" data-image-fallback="@(source == FallbackSource ? "true" : null)" @onerror="() => ImageFailed(source)" />
    }
}
else if (!OmitFallback)
{
    <span class="monogram @Class" aria-label="@Label">@Initial</span>
}
@code {
    [Parameter] public string? Source { get; set; }
    [Parameter] public string? FallbackSource { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool OmitFallback { get; set; }
    [Parameter] public PortraitEffects? Effects { get; set; }
    private string? previous;
    private string? previousFallback;
    private bool failed;
    private bool fallbackFailed;
    private string? CurrentSource => !failed && !string.IsNullOrWhiteSpace(Source) ? Source
        : !fallbackFailed && !string.IsNullOrWhiteSpace(FallbackSource) ? FallbackSource : null;
    private string Initial => string.IsNullOrWhiteSpace(Label) || Label == "—" ? "?" : System.Globalization.StringInfo.GetNextTextElement(Label.Trim()).ToUpperInvariant();
    private string ImageLabel(string source) => source == FallbackSource ? $"{Label} (placeholder)" : Label;
    private static string MaskStyle(string source) => "--avatar-mask:url(\"" + source.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "\\d ").Replace("\n", "\\a ").Replace("\f", "\\c ") + "\")";
    protected override void OnParametersSet()
    {
        if (previous != Source) { failed = false; previous = Source; }
        if (previousFallback != FallbackSource) { fallbackFailed = false; previousFallback = FallbackSource; }
    }
    private void ImageFailed(string source)
    {
        if (source == Source) failed = true;
        if (source == FallbackSource) fallbackFailed = true;
    }
}
