<section class="observed @PlayerPresentation.SideClass(Player.Side)" aria-label="Observed player">
    <div class="observed-hero">
        <span class="portrait-cell"><PlayerPortrait Player="Player" Context="Context" Class="portrait" OmitFallback="true" /></span>
    </div>
    <div class="observed-summary">
        @{ var active = Active; }
        <div class="observed-health-track" aria-hidden="true"><span style="@($"width:{Math.Clamp(Player.Health ?? 0, 0, 100)}%")"></span></div>
        <span class="observed-team">
            @if (TeamLogo is { } logo) { <ImageTile Source="@logo" Label="@TeamName" Class="observed-team-logo" OmitFallback="true" /> }
            else { <span class="observer-slot">@(Player.ObserverSlot is >= 0 and <= 9 ? Player.ObserverSlot.ToString() : "—")</span> }
        </span>
        <div class="observed-identity">
            <strong class="player-name" title="@Context.Name(Player)">@Context.Name(Player)</strong>
            <span class="observed-stats" aria-label="@($"Kills / deaths / assists: {PlayerPresentation.Kda(Player)}")">
                <span><HudUiIcon Name="kills" Label="Kills" /><span class="observed-stat-value">@BroadcastContext.Number(Player.Stats?.Kills)</span></span>
                <span><HudUiIcon Name="dead" Label="Deaths" /><span class="observed-stat-value">@BroadcastContext.Number(Player.Stats?.Deaths)</span></span>
            </span>
        </div>
        <div class="observed-loadout">
            @if (active is not null)
            {
                <span class="weapon-cell">
                    @if (active.Type == WeaponCategory.Grenade) { <UtilityIcon Name="@active.Name" Class="observed-weapon" /> }
                    else { <EquipmentIcon Name="@active.Name" Class="observed-weapon" /> }
                </span>
                @if (EquipmentPresentation.UsesAmmo(active) && (active.AmmoClip is >= 0 || active.AmmoReserve is >= 0))
                {
                    <span class="ammo-cell">
                        <Ammunition Weapon="active" />
                    </span>
                }
            }
        </div>
        <span class="observed-vitals">
            @if (Player.Armor is > 0)
            {
                <span class="observed-armor"><HudUiIcon Name="@(Player.Helmet == true ? "helmet" : "armor")" Label="@(Player.Helmet == true ? "Armor and helmet" : "Armor")" /></span>
            }
            <strong class="observed-health" aria-label="Health">@BroadcastContext.Number(Player.Health)</strong>
        </span>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public PlayerState Player { get; set; } = null!;
    [Parameter, EditorRequired] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    private WeaponState? Active => EquipmentPresentation.Active(Player);
    private string? TeamLogo => Player.Side is { } side ? Context.ResolveMedia(Context.SideTeam(side)?.Logo) : null;
    private string TeamName => Player.Side is { } side ? Context.SideTeam(side)?.Name ?? side.ToString() : "Team";
}
