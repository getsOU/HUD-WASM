<section class="observed @PlayerPresentation.SideClass(Player.Side)" aria-label="Observed player">
    <div class="observed-identity"><span class="observer-slot">@(Player.ObserverSlot is >= 0 and <= 9 ? Player.ObserverSlot.ToString() : "—")</span><span class="portrait-cell"><ImageTile Source="@Context.ProfileImage(Player.SteamId)" Label="@Context.Name(Player)" Class="portrait" OmitFallback="true" /></span><strong class="player-name" title="@Context.Name(Player)">@Context.Name(Player)</strong><span class="observed-vitals"><span class="observed-health"><StatusIcon Name="health" Label="Health" /><span>@BroadcastContext.Number(Player.Health)</span></span><span class="observed-armor"><StatusIcon Name="@(Player.Helmet == true ? "helmet" : "armor")" Label="Armor" /><span>@BroadcastContext.Number(Player.Armor)</span></span></span></div>
    <div class="observed-loadout">
        <span class="weapon-cell">@if (Active is { } active) { <EquipmentIcon Name="@active.Name" Class="observed-weapon" /> }</span>
        <span class="ammo-cell">@if (EquipmentPresentation.UsesAmmo(Active)) { <strong class="ammo" aria-label="@EquipmentPresentation.Ammo(Active)"><span>@BroadcastContext.Number(Active!.AmmoClip)</span><small>/</small><span>@BroadcastContext.Number(Active.AmmoReserve)</span></strong> }@if (Active?.State == WeaponStatus.Reloading) { <span class="reload">RELOAD</span> }</span>
        <span class="loadout-details"><UtilityIcons Player="Player" /><PlayerEquipment Player="Player" Context="Context" ShowArmor="false" /></span>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public PlayerState Player { get; set; } = null!;
    [Parameter, EditorRequired] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    private WeaponState? Active => EquipmentPresentation.Active(Player);
}
