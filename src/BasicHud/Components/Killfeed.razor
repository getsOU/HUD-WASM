<section class="killfeed" aria-label="Killfeed">
    @foreach (var item in Entries)
    {
        var kill = item.Event;
        <article class="kill-event" data-event-id="@kill.Id" @key="item.Key">
            <span class="@PlayerPresentation.SideClass(kill.Killer?.Side)">@Participant(kill.Killer)</span>
            @if (kill.Assister is { } assist) { <small>+ @Participant(assist)</small> }
            <EquipmentIcon Name="@kill.Weapon" Class="kill-weapon" /><span class="kill-victim @PlayerPresentation.SideClass(kill.Victim.Side)">@Participant(kill.Victim)</span>
            <span class="kill-flags">@if (kill.Headshot) { <StatusIcon Name="headshot" Label="Headshot" /> }@if (kill.Wallbang) { <StatusIcon Name="wallbang" Label="Wallbang" /> }@if (kill.AttackerBlind) { <StatusIcon Name="blind" Label="Attacker blind" /> }@if (kill.ThroughSmoke) { <StatusIcon Name="smoke" Label="Through smoke" /> }@if (kill.NoScope) { <StatusIcon Name="noscope" Label="No scope" /> }@if (kill.FlashAssist) { <StatusIcon Name="flashassist" Label="Flash assist" /> }</span>
        </article>
    }
</section>
@code {
    [Parameter] public IReadOnlyList<KillView> Entries { get; set; } = [];
    private static string Participant(KillParticipant? participant) => participant is null ? "WORLD" : SourceText.Name(participant.Name, HudView.Text(participant.SteamId));
}
