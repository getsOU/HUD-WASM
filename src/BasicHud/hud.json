{
  "id": "sou-basic-wasm",
  "version": "0.5.0",
  "name": "sOU Default HUD",
  "infoUrl": "https://github.com/getsOU/HUD-WASM",
  "outlineColors": {
    "ct": "#B6DEF5",
    "t": "#EEE1A0"
  },
  "apiVersion": 3,
  "runtime": "blazor-wasm",
  "entryPoint": "index.html",
  "subviews": [
    {
      "name": "Prematch",
      "route": "views/prematch"
    },
    {
      "name": "Lineups",
      "route": "views/lineups"
    },
    {
      "name": "Veto",
      "route": "views/veto"
    },
    {
      "name": "Break",
      "route": "views/break"
    },
    {
      "name": "Postmatch",
      "route": "views/postmatch"
    },
    {
      "name": "Statistics",
      "route": "views/statistics"
    },
    {
      "name": "Spotlight",
      "route": "views/spotlight"
    },
    {
      "name": "Team Economy",
      "route": "views/team-economy"
    },
    {
      "name": "Loadout Comparison",
      "route": "views/round-compare"
    },
    {
      "name": "CT/T Statistics",
      "route": "views/side-statistics"
    },
    {
      "name": "Multikills",
      "route": "views/multikills"
    },
    {
      "name": "Round Loadouts",
      "route": "views/round-buys"
    },
    {
      "name": "Economy Review",
      "route": "views/economy-evidence"
    },
    {
      "name": "Roster left",
      "route": "views/roster-left"
    },
    {
      "name": "Roster right",
      "route": "views/roster-right"
    }
  ],
  "releaseNotes": "- Show the observed player’s authorized camera in the live HUD and add Roster left and Roster right views for team cameras.\n- Keep up to ten authorized camera viewers ready when switching players or team views. Retain viewers when the HUD is hidden or the game timeline resets within the same match and map.\n- Show the configured player photo or a bundled agent portrait when a roster player has no camera feed, including before complete game data arrives.\n- Use sOU HUD SDK 0.3.0 and its synchronized clock. The desktop controls camera access and the shared broadcast delay.",
  "formatVersion": 2,
  "sdkVersion": "0.3.0",
  "requirements": {
    "requiredFeatures": [
      "host.compatibility.v1",
      "game.v3",
      "session.v3",
      "panel.v1",
      "clock.v1",
      "recordings.push.v1",
      "recordings.round-history.v1",
      "recordings.stage2.v1",
      "recordings.economy.v1"
    ],
    "optionalFeatures": [
      "killfeed.trades.v1"
    ]
  }
}
