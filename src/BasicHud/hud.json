{
  "id": "sou-basic-wasm",
  "version": "0.4.31",
  "name": "sOU Default HUD",
  "infoUrl": "https://github.com/getsOU/HUD-WASM",
  "outlineColors": {
    "ct": "#B6DEF5",
    "t": "#EEE1A0"
  },
  "apiVersion": 3,
  "runtime": "blazor-wasm",
  "entryPoint": "index.html",
  "subviews": [
    {
      "name": "Prematch",
      "route": "views/prematch"
    },
    {
      "name": "Lineups",
      "route": "views/lineups"
    },
    {
      "name": "Veto",
      "route": "views/veto"
    },
    {
      "name": "Break",
      "route": "views/break"
    },
    {
      "name": "Postmatch",
      "route": "views/postmatch"
    },
    {
      "name": "Statistics",
      "route": "views/statistics"
    },
    {
      "name": "Spotlight",
      "route": "views/spotlight"
    },
    {
      "name": "Team Economy",
      "route": "views/team-economy"
    },
    {
      "name": "Loadout Comparison",
      "route": "views/round-compare"
    },
    {
      "name": "CT/T Statistics",
      "route": "views/side-statistics"
    },
    {
      "name": "Multikills",
      "route": "views/multikills"
    },
    {
      "name": "Round Loadouts",
      "route": "views/round-buys"
    },
    {
      "name": "Economy Review",
      "route": "views/economy-evidence"
    }
  ],
  "releaseNotes": "- Use the published SOU 0.3.0-preview.9 NuGet packages and matching tool instead of the earlier unpublished local build.\n- Declare package format 2, the embedded SDK version and the host capabilities required by the existing API 3 HUD.\n- Keep all existing views, design and recording subscriptions unchanged; build and validate the complete Blazor publish output.",
  "formatVersion": 2,
  "sdkVersion": "0.3.0-preview.9",
  "requirements": {
    "requiredFeatures": [
      "host.compatibility.v1",
      "game.v3",
      "session.v3",
      "panel.v1",
      "clock.v1",
      "recordings.push.v1",
      "recordings.round-history.v1",
      "recordings.stage2.v1",
      "recordings.economy.v1"
    ],
    "optionalFeatures": []
  }
}
