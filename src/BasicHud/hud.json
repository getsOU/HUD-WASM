{
  "id": "sou-basic-wasm",
  "version": "0.4.18",
  "name": "sOU Default HUD",
  "infoUrl": "https://github.com/getsOU/HUD-WASM",
  "outlineColors": {
    "ct": "#B6DEF5",
    "t": "#EEE1A0"
  },
  "apiVersion": 3,
  "runtime": "blazor-wasm",
  "entryPoint": "index.html",
  "subviews": [
    {
      "name": "Prematch",
      "route": "views/prematch"
    },
    {
      "name": "Lineups",
      "route": "views/lineups"
    },
    {
      "name": "Veto",
      "route": "views/veto"
    },
    {
      "name": "Break",
      "route": "views/break"
    },
    {
      "name": "Postmatch",
      "route": "views/postmatch"
    },
    {
      "name": "Statistics",
      "route": "views/statistics"
    },
    {
      "name": "Spotlight",
      "route": "views/spotlight"
    }
  ]
}
