@{
    var team = CameraRoster.Team(Context, Right);
    var players = CameraRoster.Players(Context, Right);
    var upper = CameraRoster.UpperCount(players.Count);
    var show = Context.Panel is null || DisplayOptions.FromPanel(Context.Panel).ShowRosters;
}
@if (show)
{
<section lang="en" class="presentation broadcast-scene camera-roster @(Right ? "camera-roster-right" : "camera-roster-left") @PlayerPresentation.SideClass(Context.CurrentTeamSide(team?.Id))" aria-label="@(Right ? "Roster right" : "Roster left")">
    <SceneHeader Title="Roster" Context="Context" PanelSection="roster" />
    <div class="scene-body camera-roster-body">
        <header class="camera-roster-heading">
            @if (Context.ResolveMedia(team?.Logo) is { } logo) { <ImageTile Source="@logo" Label="@(team?.Name ?? "Team")" Class="camera-roster-logo" OmitFallback="true" /> }
            <h2 title="@team?.Name">@(team is null ? "Waiting for team" : team.Name)</h2>
        </header>
        <div class="camera-roster-players" style="@($"--roster-columns:{Math.Max(1, upper)}")">
        @for (var row = 0; row < 2; row++)
        {
            var members = row == 0 ? players.Take(upper) : players.Skip(upper);
            <div class="camera-roster-row" data-roster-row="@row">
            @foreach (var player in members)
            {
                <article @key="player.SteamId" class="camera-roster-player" data-roster-player="@player.SteamId">
                    <div class="camera-roster-picture" data-playercam-target="@player.SteamId"><PlayerPortrait Player="player" Context="Context" Class="camera-roster-portrait" RosterFallback="true" /></div>
                    <strong class="camera-roster-name" title="@Context.Name(player)">@Context.Name(player)</strong>
                </article>
            }
            </div>
        }
        @if (players.Count == 0) { <p class="camera-roster-empty">Waiting for roster</p> }
        </div>
    </div>
</section>
}
@code {
    [Parameter] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    [Parameter] public bool Right { get; set; }
}
