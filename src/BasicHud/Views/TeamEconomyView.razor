@using static BasicHud.Presentation.RecordingCast
@{
    var end = RecordingData.EconomyEndRound(History.Rounds, Options.Phase, Options.Round);
    var first = Math.Max(1, end - Options.Window + 1);
    var rounds = History.Rounds.Where(r => r.Number >= first && r.Number <= end).ToArray();
    var checkpoints = rounds.Select(r => RecordingData.Checkpoint(r, Options.Phase)).OfType<HudRoundCheckpoint>().ToArray();
    var ids = checkpoints.SelectMany(c => new[] { c.CtTeamId, c.TTeamId }.Concat(c.Players.Select(p => p.TeamId))).Where(id => !string.IsNullOrEmpty(id)).Cast<string>().Distinct(StringComparer.Ordinal).OrderBy(id => id == Context.Match?.TeamA.Id ? 0 : id == Context.Match?.TeamB.Id ? 1 : 2).ThenBy(id => id, StringComparer.Ordinal).ToArray();
    var missingIdentity = checkpoints.Any(c => c.Players.Any(p => p.TeamId is null && (p.Side == TeamSide.CounterTerrorists ? c.CtTeamId : p.Side == TeamSide.Terrorists ? c.TTeamId : null) is null));
    var teams = ids.Length == 2 && !missingIdentity;
    var lines = teams ? ids.Select(id => (Label: Locale.Team(Context, id), Points: RecordingData.Points(rounds, Options.Phase, id, null, Options.Equipment))).ToArray()
        : new[] { (Label: Locale["ctSide"], Points: RecordingData.Points(rounds, Options.Phase, null, TeamSide.CounterTerrorists, Options.Equipment)), (Label: Locale["tSide"], Points: RecordingData.Points(rounds, Options.Phase, null, TeamSide.Terrorists, Options.Equipment)) };
}
<div class="recording-view economy-view">
    <div class="cast-caption"><span>@(Options.Equipment ? Locale["equipmentValue"] : Locale["money"])</span><b>@Locale.Phase(Options.Phase) · @Locale["round"] @Locale.Number(end > 0 ? end : null)</b></div>
    <div class="economy-headlines">
        @for (var index = 0; index < lines.Length; index++)
        {
            var line = lines[index]; var point = line.Points.LastOrDefault(p => p.Round == end);
            <article class="economy-headline team-@index">
                <ImageTile Source="@(teams ? Logo(Context, ids[index]) : null)" Label="@line.Label" Class="recorded-team-logo" />
                <div><span class="team-name">@line.Label</span><small>@(point?.Known ?? 0)/@(point?.Observed ?? 0) @Locale["players"]</small></div>
                <strong>@Locale.Money(point?.Value)</strong>
            </article>
        }
    </div>
    <EconomyChart Lines="lines" />
</div>
@code {
    private static readonly RecordingCopy Locale = RecordingCopy.Instance;
    [Parameter, EditorRequired] public HudRoundHistory History { get; set; } = default!;
    [Parameter] public BroadcastContext Context { get; set; } = BroadcastContext.Empty;
    [Parameter, EditorRequired] public RecordingOptions Options { get; set; } = default!;
}
