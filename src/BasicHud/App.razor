@inject NavigationManager Navigation
@if (preview is not null)
{
    @Preview()
}
else if (installed)
{
    <SouHudHost TOptions="HudOptions"><V3Hud /></SouHudHost>
}
else
{
    <div class="waiting" role="alert">Open this HUD from an installed sOU package or the SDK development host.</div>
}
@code {
    private IHudFeed? preview = null;
    private bool installed;
    protected override void OnInitialized()
    {
        var address = new Uri(Navigation.Uri);
#if DEBUG
        preview = Development.PreviewFeed.TryCreate(address);
#endif
        try { _ = SOU.Hud.Sdk.HudIdentity.FromUri(address); installed = true; }
        catch (ArgumentException) { installed = false; }
    }
    private RenderFragment Preview() => builder => {
#if DEBUG
        builder.OpenComponent<Development.PreviewHud>(0);
        builder.AddAttribute(1, "Feed", preview);
        builder.CloseComponent();
#endif
    };
}
