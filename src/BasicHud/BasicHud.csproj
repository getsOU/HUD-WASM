<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup><RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="SOU.Hud.Sdk" Version="0.2.0-preview.4" />
    <PackageReference Include="SOU.Live.Contracts" Version="0.2.0-preview.4" />
    <ProjectReference Include="../BasicHud.Core/BasicHud.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="hud.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSING.md" Link="LICENSING.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES/*" Link="LICENSES/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'"><Compile Remove="Development/**/*.cs" /><Content Remove="wwwroot/cast-media/**" /></ItemGroup>
</Project>
